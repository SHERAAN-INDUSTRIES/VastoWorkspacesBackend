WORKSPACES_SECRET_KEY=
WORKSPACES_DEBUG=true
WORKSPACES_ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0
# Leave blank for the local SQLite database at workspace/db.sqlite3.
# For PostgreSQL, set this to a dedicated Workspaces database URL, for example:
# Never point Workspaces at the Vasto application's database.
# WORKSPACES_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/WORKSPACES_DB
WORKSPACES_DATABASE_URL=
# DATABASE_URL is accepted as a deployment-platform fallback when the
# Workspaces-specific URL above is not set. PGDATABASE/PGUSER/PGPASSWORD/
# PGHOST/PGPORT are also supported for PostgreSQL deployments.

VASTO_ISSUER=http://127.0.0.1:8000/o
VASTO_DISCOVERY_URL=http://127.0.0.1:8000/o/.well-known/openid-configuration
VASTO_CLIENT_ID=
VASTO_CLIENT_SECRET=
VASTO_REDIRECT_URI=http://127.0.0.1:8001/api/auth/vasto/callback/

WORKSPACES_FRONTEND_URL=http://127.0.0.1:3000
